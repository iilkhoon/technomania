{
  "expo": {
    "name": "TechnoMania",
    "slug": "technomania",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "technomania",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4f533b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "az.technomania.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocationWhenInUseUsageDescription": "Sizə ən yaxın mağazamızı və çatdırılma ünvanınızı təyin etmək üçün yerləşmə icazəsi lazımdır.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f533b"
      },
      "package": "az.technomania.app",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sizə ən yaxın mağazamızı və çatdırılma ünvanınızı təyin etmək üçün yerləşmə icazəsi lazımdır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://169.58.132.249/api",
      "eas": {
        "projectId": "cc046874-a4b2-437f-9905-b5f1ba0c1029"
      },
      "router": {}
    },
    "owner": "iilkhoon"
  }
}
